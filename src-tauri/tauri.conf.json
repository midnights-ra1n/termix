{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termix",
  "version": "0.2.1",
  "identifier": "com.midnights.termix",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Termix",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "backgroundColor": "#252C3D",
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Terminal SSH léger et personnalisable",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux.desktop",
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "desktopTemplate": "linux.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEOEM0ODlGMEUxNjhBQTMKUldTamloWU9uMGlNdlgyWGJVeHBwd2IwYUdHdkd1R0JmMlVBSDA0ckl2YlA0OXpYQ3NWdVpXWSsK",
      "endpoints": [
        "https://github.com/midnights-ra1n/termix/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}